generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── AUTH ───────────────────────────────────────
model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         String    @default("DRIVER") // "OWNER" | "ADMIN" | "DISPATCHER" | "DRIVER" | "ACCOUNTING" | "SUPPORT"
  permissions  String[]  @default([])
  name         String
  createdAt    DateTime  @default(now())

  driver            Driver?
  auditLogs         AuditLog[]
  assignedInquiries Inquiry[]
  assignedTasks     Task[]
}

// ─── FLEET ──────────────────────────────────────
model Vehicle {
  id     String  @id @default(cuid())
  code   String  @unique
  name   String
  type   String  // "TRUCK" | "VAN"
  status String  @default("AVAILABLE")

  bookings           Booking[]
  availabilityBlocks AvailabilityBlock[]
  assignments        VehicleAssignment[]
}

model Driver {
  id          String  @id @default(cuid())
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
  displayName String
  phone       String?
  active      Boolean @default(true)

  assignments VehicleAssignment[]
}

// ─── PACKAGES ────────────────────────────────────
model Package {
  id              String  @id @default(cuid())
  name            String
  slug            String  @unique
  serviceType     String  // "AMERICANO_TRUCK" | "SPRINTER_VAN"
  description     String?
  servings        Int
  price           Float
  extraPiecePrice Float
  extraGuestPrice Float   @default(5)
  durationMins    Int     @default(60)
  imageUrl        String?
  badge           String?
  features        String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  bookings Booking[]
}

// ─── BOOKINGS ────────────────────────────────────
model Customer {
  id        String    @id @default(cuid())
  firstName String
  lastName  String
  email     String
  phone     String
  address   String?
  city      String?
  zip       String?
  createdAt DateTime  @default(now())

  bookings Booking[]
  tasks    Task[]
  inquiries Inquiry[]
}

model Booking {
  id            String    @id @default(cuid())
  bookingNumber String    @unique
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id])
  packageId     String?
  package       Package?  @relation(fields: [packageId], references: [id])
  vehicleId     String?
  vehicle       Vehicle?  @relation(fields: [vehicleId], references: [id])

  status              String   @default("PENDING") // PENDING|PENDING_REVIEW|PENDING_PAYMENT|CONFIRMED|ASSIGNED|IN_PROGRESS|COMPLETED|CANCELLED|REJECTED
  eventDate           DateTime
  startTime           String
  durationMins        Int
  address             String
  city                String
  zip                 String
  guests              Int
  eventType           String
  notes               String?
  additionalStops     Int      @default(0)
  additionalStopsFee  Float    @default(0)
  totalAmount         Float    @default(0)
  internalNote        String?
  googleEventId       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  quote       Quote?
  stops       BookingStop[]
  items       BookingItem[]
  payments    Payment[]
  assignment  VehicleAssignment?
  auditLogs   AuditLog[]
  tasks       Task[]
  inquiries   Inquiry[]
}

model BookingItem {
  id          String  @id @default(cuid())
  bookingId   String
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  lineType    String
  description String
  quantity    Int     @default(1)
  unitPrice   Float
  totalPrice  Float
}

model BookingStop {
  id          String   @id @default(cuid())
  bookingId   String
  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  stopOrder   Int
  label       String?
  street      String
  city        String
  state       String   @default("MA")
  zipCode     String
  latitude    Float?
  longitude   Float?
  notes       String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bookingId])
  @@index([zipCode])
}

model Quote {
  id            String  @id @default(cuid())
  bookingId     String  @unique
  booking       Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  basePrice     Float
  distanceMiles Float   @default(0)
  travelFee     Float   @default(0)
  overtimeFee   Float   @default(0)
  totalAmount   Float
  snapshotJson  String
  version       Int     @default(1)
  createdAt     DateTime @default(now())
}

model AvailabilityBlock {
  id        String   @id @default(cuid())
  vehicleId String
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  blockType String   // "BLACKOUT" | "MAINTENANCE" | "MANUAL_HOLD"
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
}

model VehicleAssignment {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id])
  driverId   String?
  driver     Driver?  @relation(fields: [driverId], references: [id])
  assignedAt DateTime @default(now())
  jobStatus  String   @default("PENDING") // PENDING|ON_THE_WAY|ARRIVED|COMPLETED
  driverNote String?
}

// ─── PAYMENTS ────────────────────────────────────
model Payment {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gateway        String   @default("STRIPE")
  intentId       String?  @unique
  amount         Float
  refundedAmount Float    @default(0)
  status         String
  createdAt      DateTime @default(now())
}

// ─── AI LEADS & INQUIRIES ─────────────────────────
model Inquiry {
  id           String    @id @default(cuid())
  name         String
  email        String
  phone        String?
  eventType    String?
  eventDate    DateTime?
  guestCount   Int?
  notes        String?
  internalNote String?
  status       String    @default("NEW") // NEW | IN_PROGRESS | RESOLVED | CLOSED
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  source       String    @default("CHAT_WIDGET") // CHAT_WIDGET | CONTACT_FORM | BOOKING | EMAIL
  pageUrl      String?
  
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])

  createdAt    DateTime  @default(now())

  tasks        Task[]
}

model AssistantMessage {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  createdAt DateTime @default(now())
}

// ─── TASKS ───────────────────────────────────────
model Task {
  id           String    @id @default(cuid())
  title        String
  description  String?
  dueDate      DateTime?
  priority     String    @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  status       String    @default("TODO")   // TODO | IN_PROGRESS | DONE | BLOCKED
  
  assignedToId String?
  assignedTo   User?     @relation(fields: [assignedToId], references: [id])

  inquiryId    String?
  inquiry      Inquiry?  @relation(fields: [inquiryId], references: [id])

  bookingId    String?
  booking      Booking?  @relation(fields: [bookingId], references: [id])

  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])

  createdAt    DateTime  @default(now())
}

// ─── AUDIT ───────────────────────────────────────
model AuditLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  action       String
  actorId      String?
  user         User?    @relation(fields: [actorId], references: [id])
  metadataJson String
  createdAt    DateTime @default(now())

  bookingId    String?
  booking      Booking? @relation(fields: [bookingId], references: [id])
}

// ─── SETTINGS ────────────────────────────────────
model Setting {
  key   String @id
  value String
}

// ─── OTP VERIFICATION ────────────────────────────────
model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ─── SERVICE ZIP CODES (Massachusetts) ───────────────
model ServiceZipCode {
  id        String   @id @default(cuid())
  zip       String   @unique
  city      String
  county    String?
  isActive  Boolean  @default(true)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
